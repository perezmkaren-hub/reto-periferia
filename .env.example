# Clave del proveedor de lenguaje (Google Gemini). Nunca se sube al repositorio.
GEMINI_API_KEY=
# Modelo principal y de respaldo (si el principal está saturado)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_RESPALDO=gemini-3.1-flash-lite
# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
LLM_TIMEOUT_MS=60000
PORT=3000
# Fecha simulada de la demo (PRD §11). En producción se deja vacía y se usa la fecha real.
FECHA_REFERENCIA=2026-09-03
# Tope global diario de tokens y límite de mensajes por IP (link público)
MAX_TOKENS_DIA=3000000
MAX_MENSAJES_IP_10MIN=30
# Si se define, "Reiniciar demo" pide esta clave
ADMIN_KEY=
